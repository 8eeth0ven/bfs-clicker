    "x": 0.05,
    "y": 0.2,
    "width": 0.9,
    "height": 0.08
  },
  "resultRegion": {
    "x": 0.05,
    "y": 0.47,
    "width": 0.9,
    "height": 0.12
  },
  "resultPrefix": "RESULT"
}
