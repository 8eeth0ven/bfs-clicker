{
  "name": "bfs-clicker",
  "version": "1.0.0",
  "type": "module",
  "description": "Playwright Web 控制台探索、Android/iOS 与 ELF/Mach-O 接口证据提取及受控验证，以及 TypeScript MCP 网关",
  "files": [
    "gateway/",
    "apk_tools/",
    "docs/apk-mcp-architecture.md",
    "docs/apk-mcp-verification.md",
    "docs/web-guide.md",
    "docs/ios-native-guide.md",
    "docs/capture-setup.md",
    "capture-setup.sh",
    "capture-setup.command",
    "docs/images/",
    "src/",
    "view/",
    "demo/",
    "config.json",
    "README.md",
    "docs/implementation-status.md",
    "docs/project-review.md",
    "docs/tencent-deploy.md",
    "scripts/dedup-traffic.mjs"
  ],
  "scripts": {
    "setup:capture": "bash capture-setup.sh",
    "gateway:build": "npm --prefix gateway run build",
    "test:gateway": "npm --prefix gateway test",
    "test:apk": "python3 -m unittest discover -s apk_tools/tests",
    "demo:apk-mcp": "node gateway/examples/apk-e2e.mjs",
    "demo:ios-mcp": "node gateway/examples/ios-e2e.mjs",
    "run": "node src/index.js run",
    "doctor": "node src/index.js doctor",
    "login": "node src/index.js login",
    "crawl": "node src/index.js crawl",
    "resume": "node src/index.js resume",
    "demo": "node src/index.js demo",
    "view": "node view/server.js",
    "dedup-traffic": "node scripts/dedup-traffic.mjs",
    "test:unit": "node scripts/test-urlshape.mjs && node scripts/test-paper-scripts.mjs",
    "test:integration": "node scripts/test-route-discovery.mjs && node scripts/test-api-surface.mjs",
    "test:python": "node scripts/test-python.mjs",
    "test:e2e": "node scripts/test-asset-workflow.mjs && node scripts/test-local-panel.mjs",
    "test": "npm run test:unit && npm run test:integration && npm run test:python && npm run test:e2e"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "playwright": "^1.62.1",
    "ws": "^8.21.0"
  }
}
